# Editor settings, also read by Prettier (indentation and line endings)
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# npm and scripts/version-bump.mjs write the JSON files with 4 spaces
[*.json]
indent_size = 4
