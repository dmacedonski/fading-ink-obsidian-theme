{
    "name": "fading-ink",
    "version": "0.3.1",
    "private": true,
    "scripts": {
        "build": "node scripts/build.mjs",
        "dev": "node --watch-path=src --watch-path=fonts scripts/build.mjs",
        "version": "node scripts/version-bump.mjs && git add manifest.json versions.json",
        "lint": "stylelint \"src/**/*.css\"",
        "format": "prettier --write src scripts tools .github \"*.{mjs,md,json}\" \"!package-lock.json\"",
        "format:check": "prettier --check src scripts tools .github \"*.{mjs,md,json}\" \"!package-lock.json\""
    },
    "devDependencies": {
        "prettier": "3.9.10",
        "stylelint": "^17.0.0",
        "stylelint-config-obsidianmd": "^0.1.0"
    }
}
